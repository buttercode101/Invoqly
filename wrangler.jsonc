{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "invoqly-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "vars": {
    "BETTER_AUTH_URL": "https://invoqly-preview.buttercoder-dev.workers.dev",
    "NEXT_PUBLIC_APP_URL": "https://invoqly-preview.buttercoder-dev.workers.dev",
    "AUTH_EMAIL_VERIFICATION": "false"
  }
}
