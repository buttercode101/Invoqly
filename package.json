{
  "name": "invoqly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.mjs",
    "test:e2e:remote": "playwright test",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "@better-auth/drizzle-adapter": "1.7.18",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7",
    "postgres": "3.4.7",
    "@opennextjs/cloudflare": "1.20.16"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "vitest": "5.1.0",
    "@playwright/test": "^1.56.1",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
